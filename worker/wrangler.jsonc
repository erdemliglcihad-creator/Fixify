{
  // Fixify cloud server. Deploy: npx wrangler deploy
  // Secrets (never in this file): npx wrangler secret put AI_API_KEY / OCR_SPACE_KEY
  "name": "fixify-cloud",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "LIMITER", "class_name": "Limiter" }]
  },
  "exports": {
    "Limiter": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    // Free AI provider (OpenAI-compatible). Switch to Mistral or others by changing these three values.
    "AI_PROVIDER_NAME": "groq",
    "AI_BASE_URL": "https://api.groq.com/openai/v1",
    "AI_MODEL": "qwen/qwen3.8-27b",
    // Claude later: set "AI_PROVIDER": "anthropic" and the ANTHROPIC_API_KEY secret.
    "AI_PROVIDER": "openai-compatible",
    // FixBot text chain: tried in order; a used-up free quota moves on to the next, smaller model.
    "STT_MODEL": "whisper-large-v3-turbo",
    // Fish Audio voices for FixVoice (active once the FISH_API_KEY secret is set).
    "FISH_VOICE_EN_MALE": "919aeec52e4548b0b2f89252dff277bb",
    "FISH_VOICE_DE_MALE": "90042f762dbf49baa2e7776d011eee6b",
    "FISH_VOICE_EN_FEMALE": "7cefff1c89464d7dbc412482f909ec2d",
    "FISH_VOICE_DE_FEMALE": "b59d1164746a48bf971f4a0fd2cbf814",
    "CHAT_MODELS": "openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.1-8b-instant",
    // Daily limits. 10 different photos per device; messages have a generous hidden fair-use cap.
    // Groq's free vision quota (~200k tokens/day) covers roughly 50 photo calls for everyone together.
    "UPLOADS_DAILY": "10",
    "IP_UPLOADS_DAILY": "30",
    "MESSAGES_DAILY": "150",
    "GLOBAL_VISION_DAILY": "50",
    "GLOBAL_OCR_DAILY": "450",
    "MAX_IMAGES": "2",
    // Draw AI-estimated marker boxes for this provider? Off: qwen's boxes were measurably wrong.
    "TRUST_AI_BOXES": "false"
  },
  "observability": { "enabled": true }
}

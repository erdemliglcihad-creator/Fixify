        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbegrenzt"
          }
        }
      }
    },
    "Up to four photos (reduced to about 1600 pixels), the recognized text, your description, answers and the steps you tried in this session.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu vier Fotos (verkleinert auf etwa 1600 Pixel), der erkannte Text, deine Beschreibung, Antworten und die Schritte, die du in dieser Session ausprobiert hast."
          }
        }
      }
    },
